{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wanjie:0.2:context",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "budget": {
      "type": "integer",
      "minimum": 0
    },
    "used": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 100
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 1000
    },
    "builtAt": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "intent",
    "revision",
    "budget",
    "used",
    "items",
    "excluded",
    "builtAt"
  ],
  "additionalProperties": false
}
