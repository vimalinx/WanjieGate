{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wanjie:0.2:relation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "type": {
      "const": "relation"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "predicate": {
      "type": "string",
      "enum": [
        "belongs_to",
        "references",
        "produced_by",
        "depends_on",
        "supports",
        "conflicts_with",
        "derived_from"
      ]
    },
    "object": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "source": {
      "type": "string",
      "maxLength": 200
    },
    "created": {
      "type": "integer",
      "minimum": 0
    },
    "updated": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "intent",
    "subject",
    "predicate",
    "object",
    "source",
    "created",
    "updated"
  ],
  "additionalProperties": false
}
