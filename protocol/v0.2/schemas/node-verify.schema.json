{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wanjie:0.2:node-verify",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 160
    },
    "stage": {
      "const": "VERIFY"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "waiting",
        "rejected",
        "failed"
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "execute": {
          "type": "string"
        }
      },
      "required": [
        "execute"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "verified",
        "reason"
      ],
      "additionalProperties": false
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "stage",
    "status",
    "inputs",
    "outputs",
    "timestamp"
  ],
  "additionalProperties": false
}
