{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wanjie:0.2:node-execute",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 160
    },
    "stage": {
      "const": "EXECUTE"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "waiting",
        "rejected",
        "failed"
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        }
      },
      "required": [
        "commit"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "executed": {
          "type": "boolean"
        }
      },
      "required": [
        "executed"
      ],
      "additionalProperties": false
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "stage",
    "status",
    "inputs",
    "outputs",
    "timestamp"
  ],
  "additionalProperties": false
}
