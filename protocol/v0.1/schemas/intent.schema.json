{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wanjie:0.1:intent",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "type": {
      "const": "intent"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "state": {
      "type": "object",
      "properties": {
        "thread": {
          "type": "string",
          "maxLength": 300
        },
        "goal": {
          "type": "string",
          "maxLength": 300
        },
        "domain": {
          "type": "string",
          "maxLength": 300
        },
        "phase": {
          "type": "string",
          "maxLength": 300
        },
        "target": {
          "type": "string",
          "maxLength": 300
        },
        "attention": {
          "type": "string",
          "maxLength": 300
        },
        "commitment": {
          "type": "string",
          "maxLength": 300
        },
        "urgency": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "warm",
        "suspended",
        "archived"
      ]
    },
    "parent": {
      "type": "string",
      "maxLength": 160
    },
    "created": {
      "type": "integer",
      "minimum": 0
    },
    "updated": {
      "type": "integer",
      "minimum": 0
    },
    "fieldSources": {
      "type": "object"
    },
    "preferences": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "title",
    "state",
    "status",
    "created",
    "updated"
  ],
  "additionalProperties": false
}
