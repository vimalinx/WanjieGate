{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100000
          },
          "total": {
            "type": "number"
          },
          "mean": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "name",
          "total",
          "mean",
          "min",
          "max",
          "values"
        ]
      },
      "maxItems": 1000
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100000
      },
      "maxItems": 1000
    }
  },
  "required": [
    "columns",
    "count",
    "labels"
  ]
}
